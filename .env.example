# PowerLaw / ConstructPulse Ingestion Environment Contract
# Copy to .env and configure for your deployment

# Operating Mode: production, demo, test
POWERLAW_MODE=production
POWERLAW_DATA_DIR=./data/production
LANCEDB_PATH=./data/production/lancedb
POWERLAW_SQLITE_PATH=./data/production/ingestion.sqlite

# Object Storage Backend (local or s3)
POWERLAW_OBJECT_BACKEND=local
MINIO_ENDPOINT=
MINIO_SECURE=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
POWERLAW_OBJECT_BUCKET=powerlaw-evidence
POWERLAW_OBJECT_PREFIX=powerlaw

# Storage Limits & Disk Floor
POWERLAW_CACHE_LIMIT_BYTES=2147483648
POWERLAW_TEMP_LIMIT_BYTES=536870912
POWERLAW_DISK_FLOOR_BYTES=2147483648

# AI & Model Extraction (Google Gemini)
# Sign in locally with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_EMBEDDING_LOCATION=us-central1
POWERLAW_EXTRACTION_BUDGET_USD=0.0
# Overall cap across runs in this SQLite ledger; 0 leaves this optional cap unconfigured.
# Keep the per-run budget above at 0 until paid processing is explicitly authorized.
POWERLAW_EXTRACTION_TOTAL_BUDGET_EUR=0
# ECB 2026-10-19 USD/EUR; total ceiling retains a 10% FX/billing buffer.
POWERLAW_EXTRACTION_EUR_USD_RATE=1.1225
# Verified gross standard online rates, USD/1000 tokens; promotional credits not assumed.
# Source: https://cloud.google.com/gemini-enterprise-agent-platform/generative-ai/pricing
# Verified 2026-10-19: global 3.8 Flash $1.50/$7.50 per million; embedding $0.15/million.
POWERLAW_EXTRACTION_INPUT_PRICE_USD_PER_1K=0.0015
POWERLAW_EXTRACTION_OUTPUT_PRICE_USD_PER_1K=0.0075
POWERLAW_EXTRACTION_EMBEDDING_PRICE_USD_PER_1K=0.00015
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=dynamic

# Optional Public Data Tokens
GENESIS_API_TOKEN=
ENTSOE_API_TOKEN=
FRED_API_KEY=
